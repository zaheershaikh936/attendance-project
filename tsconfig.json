{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "ESNext",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "preserveSymlinks": true,
    "esModuleInterop": true,
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@lib/*": ["./src/lib/*"],
      "@types/*": ["./src/types/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
